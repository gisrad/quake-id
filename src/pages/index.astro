---
import '../lib/sentinel-status.css';

const title = 'Sentinel Seismik · Katalog dan Peta Gempa Indonesia';
const description = 'Katalog gempa BMKG dan USGS, profil kedalaman, serta peta zona tektonik perkiraan. Peringatan resmi tetap mengacu pada BMKG InaTEWS.';
const canonicalUrl = 'https://quake.transbulent.id/';
const ogImage = 'https://quake.transbulent.id/og-quake.png?v=20261124';
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Sentinel Seismik',
      alternateName: 'Quake Watch Indonesia',
      url: canonicalUrl,
      description,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Web',
      inLanguage: ['id', 'en'],
      isAccessibleForFree: true,
      screenshot: ogImage,
      spatialCoverage: {
        '@type': 'Place',
        name: 'Indonesia',
        geo: {
          '@type': 'GeoShape',
          box: '-11.8 94.0 7.0 141.2'
        }
      }
    },
    {
      '@type': 'Dataset',
      name: 'Indonesia Fused BMKG InaTEWS & USGS ComCat Seismicity & Tectonic Regime Catalog (Live + Palu & Lombok 2018 Replays)',
      description: 'Indonesian earthquake catalog combining reports from BMKG and USGS ComCat. Tectonic zones are approximate estimates, not fault attribution or hazard warnings.',
      url: canonicalUrl,
      isAccessibleForFree: true,
      keywords: [
        'gempa bumi Indonesia',
        'BMKG InaTEWS',
        'USGS',
        'megathrust',
        'sesar aktif',
        'Wadati-Benioff',
        'Palu 2018',
        'Lombok 2018'
      ],
      spatialCoverage: {
        '@type': 'Place',
        name: 'Indonesia',
        geo: {
          '@type': 'GeoShape',
          box: '-11.8 94.0 7.0 141.2'
        }
      }
    }
  ]
};
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="peta gempa indonesia, gempa terkini bmkg, sesar aktif, zona megathrust, kedalaman gempa, sesar palu koro, sesar lembang, usgs indonesia" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#090d14" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content="Sentinel Seismik · Transbulent" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Peta gempa bumi 3D Indonesia beserta sesar aktif dan zona megathrust" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <main id="map" aria-label="Peta seismisitas dan sesar aktif Indonesia"></main>

    <aside id="panel" data-open="true" aria-label="Panel kontrol dan katalog gempa Indonesia">
      <header class="brand">
        <span class="dot" aria-hidden="true"></span>
        <h1>Sentinel Seismik</h1>
        <button id="panel-toggle" type="button" aria-expanded="true" aria-controls="panel-body" aria-label="Lipat atau buka panel">
          <span class="ico-fold" aria-hidden="true">−</span>
        </button>
      </header>

      <button id="latest-felt" class="felt-banner" type="button" hidden>
        <div class="felt-top">
          <span id="latest-mmi" class="mmi-pill">Gempa terakhir</span>
          <span id="latest-ago" class="felt-ago">–</span>
        </div>
        <div id="latest-desc" class="felt-desc"></div>
      </button>

      <div id="user-loc-card" class="user-card" hidden>
        <div class="user-card-head">
          <button id="user-loc-fly" type="button" class="user-fly-btn">
            <span class="user-dot" aria-hidden="true"></span>
            <span id="user-loc-title">Posisi Anda</span>
          </button>
          <button id="user-loc-clear" type="button" class="user-close-btn" aria-label="Hapus lokasi saya">×</button>
        </div>
        <div id="user-loc-meta" class="user-card-meta"></div>
      </div>

      <dl class="stats" aria-label="Ringkasan kegempaan">
        <div><dt>Dangkal ≤60 km</dt><dd id="stat-shallow">–</dd></div>
        <div class="stat-felt"><dt>Dirasakan · BMKG</dt><dd id="stat-felt">–</dd></div>
        <div class="stat-mag"><dt>Magnitudo maks.</dt><dd id="stat-maxmag">–</dd></div>
      </dl>
      <div class="sentinel-status">
        <p id="live-note" class="note" role="status">Memuat data 24 jam…</p>
        <button id="retry-live" type="button" hidden>Coba lagi</button>
        <p id="map-note" class="note" role="status" hidden>Peta belum tersedia. Gunakan daftar untuk melihat detail.</p>
        <a href="https://inatews.bmkg.go.id/">Info dan peringatan resmi BMKG InaTEWS</a>
      </div>

      <div id="panel-body">
        <div class="seg" role="group" aria-label="Mode tampilan">
          <button type="button" data-mode="live" aria-pressed="true">Langsung</button>
          <button type="button" data-mode="replay" aria-pressed="false">Replay Historis</button>
        </div>

        <section id="live-controls">
          <div class="seg small" role="group" aria-label="Rentang waktu">
            <button type="button" data-hours="24" aria-pressed="true">24 j</button>
            <button type="button" data-hours="72" aria-pressed="false">3 h</button>
            <button type="button" data-hours="168" aria-pressed="false">7 h</button>
            <button type="button" data-hours="720" aria-pressed="false">30 h</button>
          </div>
        </section>

        <section id="replay-controls" hidden>
          <div class="seg small" role="group" aria-label="Pilih skenario historis">
            <button type="button" data-scenario="palu-2018" aria-pressed="true">Palu 2018 · M7.5</button>
            <button type="button" data-scenario="lombok-2018" aria-pressed="false">Lombok 2018 · M6.9</button>
          </div>
          <div class="replay-row">
            <button id="replay-play" type="button">Putar</button>
            <button id="replay-speed" type="button" title="Ubah kecepatan putar">1×</button>
            <output id="replay-label" for="replay-slider"></output>
          </div>
          <svg id="replay-spark" viewBox="0 0 300 32" preserveAspectRatio="none" aria-hidden="true"></svg>
          <input id="replay-slider" type="range" min="0" max="1000" step="30" value="500" aria-label="Waktu replay gempa" />
          <p id="replay-note" class="note"></p>
        </section>

        <p id="situation-summary" class="summary" role="status">Memuat katalog BMKG &amp; USGS…</p>

        <div class="depth-box">
          <div class="depth-head">
            <span>Penampang Hiposenter</span>
            <span id="depth-axis">94°BT – 141°BT · 0–650 km</span>
          </div>
          <svg id="depth-profile" viewBox="0 0 320 94" role="img" aria-label="Profil kedalaman hiposenter gempa 0 hingga 650 km"></svg>
        </div>

        <div class="source-pills" role="group" aria-label="Filter rezim tektonik gempa">
          <button type="button" data-regime="crustal" aria-pressed="true"><i class="sw sw-crust"></i>Zona kerak</button>
          <button type="button" data-regime="megathrust" aria-pressed="true"><i class="sw sw-mega"></i>Dekat megathrust</button>
          <button type="button" data-regime="intraslab" aria-pressed="true"><i class="sw sw-slab"></i>Dalam &gt;60</button>
        </div>

        <div class="legend-bar" aria-label="Legenda kedalaman dan sesar aktif">
          <span class="leg-item"><i style="--c:#ff4d5e"></i>Kerak &le;35km</span>
          <span class="leg-item"><i style="--c:#ffb020"></i>Subduksi &le;60km</span>
          <span class="leg-item"><i class="ring" style="--c:#38bdf8"></i>60–300km</span>
          <span class="leg-item"><i class="ring" style="--c:#818cf8"></i>&gt;300km</span>
        </div>

        <div class="layers">
          <label><input id="filter-mag" type="checkbox" /> M 4.0+</label>
          <label><input id="toggle-faults" type="checkbox" data-map-control disabled checked /> Sesar &amp; Palung</label>
          <label><input id="toggle-3d" type="checkbox" data-map-control disabled /> Medan 3D</label>
          <label><input id="toggle-imagery" type="checkbox" data-map-control disabled /> Satelit</label>
        </div>

        <div class="list-tabs" role="group" aria-label="Kategori daftar gempa">
          <button id="tab-shallow" type="button" data-list-tab="shallow" aria-pressed="true">Gempa dangkal</button>
          <button id="tab-deep" type="button" data-list-tab="deep" aria-pressed="false">Gempa dalam</button>
        </div>
        <p id="incident-empty" class="note" hidden>Tidak ada kejadian pada filter yang aktif.</p>
        <ol id="incident-list"></ol>

        <details class="about">
          <summary>Tentang data &amp; pemisahan tektonik</summary>
          <p>Katalog ini memadukan laporan BMKG dan USGS. Data dapat berubah setelah pemeriksaan lanjutan. Cakupan berbeda menurut sumber, waktu, dan magnitudo. Pencocokan antarsumber menggunakan perkiraan jarak, waktu, dan magnitudo.</p>
          <p>Zona tektonik diperkirakan dari lokasi dan kedalaman. Zona atau sesar terdekat tidak membuktikan penyebab gempa. Magnitudo mengukur ukuran gempa; MMI menggambarkan intensitas guncangan di suatu lokasi.</p>
          <p>Keterangan katalog bukan peringatan aktif. Ikuti <a href="https://inatews.bmkg.go.id/">informasi resmi BMKG InaTEWS</a>.</p>
        </details>
      </div>
    </aside>

    <dialog id="event-detail" aria-labelledby="detail-heading">
      <h2 id="detail-heading">Detail gempa</h2>
      <div data-detail></div>
      <form method="dialog"><button type="submit">Tutup</button></form>
    </dialog>

    <button id="panel-reopen" type="button" aria-label="Buka panel Sentinel Seismik" hidden>
      <span class="dot" aria-hidden="true"></span>
      <span>Panel</span>
    </button>

    <nav id="region-bar" aria-label="Fokus busur tektonik Indonesia">
      <button id="btn-locate" type="button" class="loc-pill" aria-pressed="false" title="Tandai posisi Anda lewat Wi-Fi / GPS">⌖ Lokasi Saya</button>
      <button type="button" data-region="nusantara" data-map-control disabled aria-pressed="true">Nusantara</button>
      <button type="button" data-region="sumatera" data-map-control disabled aria-pressed="false">Sumatera</button>
      <button type="button" data-region="jawa_nusa" data-map-control disabled aria-pressed="false">Jawa · Nusa</button>
      <button type="button" data-region="sulawesi" data-map-control disabled aria-pressed="false">Sulawesi</button>
      <button type="button" data-region="maluku_banda" data-map-control disabled aria-pressed="false">Maluku · Banda</button>
      <button type="button" data-region="papua" data-map-control disabled aria-pressed="false">Papua</button>
    </nav>

    <div id="geo-prompt" class="geo-prompt" role="region" aria-label="Permintaan lokasi perangkat" hidden>
      <div class="geo-prompt-top">
        <span class="user-dot" aria-hidden="true"></span>
        <div class="geo-prompt-copy">
          <strong>Tampilkan posisi Anda?</strong>
          <span id="geo-prompt-sub">Wi-Fi / GPS · jarak gempa &amp; sesar terdekat</span>
        </div>
        <button id="geo-close" type="button" class="geo-close" aria-label="Tutup permintaan lokasi">×</button>
      </div>
      <div class="geo-prompt-actions">
        <button id="geo-allow" type="button" class="geo-btn-primary">Aktifkan Lokasi</button>
      </div>
    </div>

    <style is:global>
      @font-face {
        font-family: "Schibsted Grotesk";
        src: url("/fonts/SchibstedGrotesk-wght.woff2") format("woff2");
        font-weight: 400 800;
        font-style: normal;
        font-display: swap;
      }

      :root {
        --bg: #090d14;
        --panel: rgba(12, 17, 26, 0.90);
        --line: #334155;
        --line-soft: #1e293b;
        --fg: #e8edf5;
        --ash: #94a3b8;
        --crustal: #ff4d5e;
        --mega: #ffb020;
        --felt: #f97316;
        --slab: #38bdf8;
        --slab-deep: #818cf8;
        --user: #10b981;
        --sans: "Schibsted Grotesk", system-ui, -apple-system, "Segoe UI", sans-serif;
        --mono: ui-monospace, "Cascadia Mono", Consolas, monospace;
        color-scheme: dark;
      }

      * { box-sizing: border-box; }
      [hidden] { display: none !important; }

      html, body {
        margin: 0;
        height: 100%;
        background: var(--bg);
        color: var(--fg);
        font: 14px/1.45 var(--sans);
        overflow: hidden;
      }

      :focus-visible {
        outline: 2px solid var(--mega);
        outline-offset: 2px;
      }

      #map { position: fixed; inset: 0; }

      .seismic-pulse-marker {
        width: 18px;
        height: 18px;
        color: var(--crustal);
        pointer-events: none;
      }

      .seismic-pulse-marker[data-regime='megathrust'] { color: var(--mega); }
      .seismic-pulse-marker[data-regime='intraslab'] { color: #38bdf8; }
      .seismic-pulse-marker[data-regime='intraslab'].very-deep { color: #818cf8; }

      /* MapLibre positions the outer marker with transform; only animate its ring. */
      .seismic-pulse-marker::after {
        content: '';
        position: absolute;
        inset: 0;
        border: 1px solid currentColor;
        border-radius: 50%;
        opacity: 0;
        animation: seismic-ripple 2.3s ease-out var(--pulse-delay) 2;
      }

      @keyframes seismic-ripple {
        0% { transform: scale(0.78); opacity: 0.52; }
        68%, 100% { transform: scale(1.78); opacity: 0; }
      }

      #panel {
        position: fixed;
        top: 12px;
        left: 12px;
        width: 354px;
        max-height: calc(100% - 24px);
        display: flex;
        flex-direction: column;
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 10px;
        backdrop-filter: blur(10px);
        box-shadow: 0 14px 36px rgba(0, 0, 0, 0.55);
        z-index: 3;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        border-bottom: 1px solid var(--line-soft);
      }

      .brand h1 {
        margin: 0;
        font-size: 14px;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        flex: 1;
      }

      .dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: var(--crustal);
        box-shadow: 0 0 10px var(--crustal);
        flex: none;
      }

      #panel-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 36px;
        min-height: 36px;
        background: transparent;
        border: 1px solid var(--line);
        color: var(--fg);
        border-radius: 6px;
        font: 700 16px/1 var(--mono);
        cursor: pointer;
      }
      #panel-toggle:hover { border-color: var(--mega); color: var(--mega); }

      #panel-reopen {
        position: fixed;
        top: 12px;
        left: 12px;
        z-index: 3;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 38px;
        padding: 6px 12px;
        background: var(--panel);
        color: var(--fg);
        border: 1px solid var(--line);
        border-radius: 8px;
        backdrop-filter: blur(10px);
        font: 700 12px/1 var(--sans);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        cursor: pointer;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.45);
      }
      #panel-reopen:hover { border-color: var(--mega); }

      .felt-banner {
        display: grid;
        gap: 3px;
        margin: 10px 14px 2px;
        padding: 8px 10px;
        text-align: left;
        background: rgba(255, 255, 255, 0.045);
        border: 1px solid var(--line);
        border-left: 3px solid var(--ash);
        border-radius: 6px;
        color: var(--fg);
        cursor: pointer;
      }
      .felt-banner:hover { background: rgba(255, 255, 255, 0.08); border-color: var(--ash); }
      .felt-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
      .mmi-pill {
        font: 700 10px/1 var(--mono);
        padding: 3px 6px;
        border-radius: 4px;
        background: var(--line);
        color: var(--fg);
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }
      .felt-ago { font: 600 11px/1 var(--mono); color: var(--ash); }
      .felt-desc { font: 700 12.5px/1.3 var(--sans); color: var(--fg); }

      .user-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: var(--user);
        border: 1.5px solid #fff;
        box-shadow: 0 0 8px rgba(16, 185, 129, 0.85);
        flex: none;
        display: inline-block;
      }

      .user-pin-marker {
        position: relative;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: var(--user);
        border: 2.5px solid #fff;
        box-shadow: 0 0 14px rgba(16, 185, 129, 0.95);
        cursor: pointer;
      }
      .user-pin-marker::after {
        content: "";
        position: absolute;
        inset: -8px;
        border-radius: 50%;
        border: 1.5px solid rgba(16, 185, 129, 0.7);
        animation: seismic-ripple 2.6s cubic-bezier(0.16, 1, 0.3, 1) infinite;
      }

      .user-card {
        margin: 8px 14px 2px;
        padding: 7px 9px;
        border-radius: 6px;
        background: rgba(16, 185, 129, 0.08);
        border: 1px solid rgba(16, 185, 129, 0.35);
        border-left: 3px solid var(--user);
        display: grid;
        gap: 3px;
      }
      .user-card-head { display: flex; align-items: center; justify-content: space-between; gap: 6px; }
      .user-fly-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        flex: 1;
        min-width: 0;
        background: transparent;
        border: 0;
        padding: 2px 0;
        color: var(--fg);
        font: 700 12px/1.2 var(--sans);
        text-align: left;
        cursor: pointer;
      }
      .user-fly-btn:hover { color: #6ee7b7; }
      .user-close-btn {
        min-width: 26px;
        min-height: 26px;
        background: transparent;
        border: 1px solid rgba(148, 163, 184, 0.3);
        border-radius: 5px;
        color: var(--ash);
        font: 700 14px/1 var(--mono);
        cursor: pointer;
        flex: none;
      }
      .user-close-btn:hover { color: var(--fg); border-color: var(--ash); }
      .user-card-meta { font: 11px/1.35 var(--mono); color: #a7f3d0; }

      .stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 6px;
        margin: 8px 14px 8px;
      }

      .stats div {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-width: 0;
        border: 1px solid var(--line);
        border-radius: 6px;
        padding: 6px 7px;
        background: rgba(255, 255, 255, 0.02);
      }

      .stats .stat-felt dd { color: var(--felt); }
      .stats .stat-mag dd { color: var(--mega); }

      .stats dt {
        font-size: 9.5px;
        line-height: 1.2;
        color: var(--ash);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        overflow-wrap: break-word;
      }

      .stats dd {
        margin: 2px 0 0;
        font: 700 15px/1.15 var(--mono);
        font-variant-numeric: tabular-nums;
      }

      #panel-body {
        overflow-y: auto;
        padding: 4px 14px 14px;
      }

      .seg { display: flex; gap: 6px; margin: 2px 0 8px; }

      .seg button {
        flex: 1;
        min-height: 36px;
        background: transparent;
        color: var(--fg);
        border: 1px solid var(--line);
        border-radius: 6px;
        padding: 6px 8px;
        font: 700 11.5px/1.2 var(--mono);
        text-transform: uppercase;
        cursor: pointer;
      }

      .seg button[aria-pressed="true"] {
        background: var(--mega);
        color: #090d14;
        border-color: var(--mega);
      }

      .seg.small button { min-height: 33px; padding: 4px 6px; font-size: 11px; }

      .note { color: var(--ash); font-size: 12px; margin: 4px 0 8px; }
      .note.warn { color: #fcd34d; }

      .summary {
        margin: 6px 0 8px;
        padding: 7px 9px;
        border-left: 2px solid var(--mega);
        background: rgba(255, 176, 32, 0.08);
        border-radius: 0 6px 6px 0;
        font-size: 12px;
        line-height: 1.35;
        color: var(--fg);
      }

      .depth-box {
        margin: 6px 0 8px;
        padding: 7px 8px 5px;
        border: 1px solid var(--line-soft);
        border-radius: 6px;
        background: rgba(6, 10, 17, 0.72);
      }
      .depth-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font: 600 10px/1.1 var(--mono);
        color: var(--ash);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 4px;
      }
      #depth-profile {
        display: block;
        width: 100%;
        height: 94px;
      }
      #depth-profile circle.q-node { cursor: pointer; transition: r 120ms ease; }
      #depth-profile circle.q-node:hover { stroke: #fff; stroke-width: 1.6; }

      .source-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin: 6px 0;
      }

      .source-pills button {
        flex: 1 1 auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        min-height: 32px;
        padding: 4px 6px;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: rgba(255, 255, 255, 0.03);
        color: var(--fg);
        font: 600 11px/1 var(--sans);
        cursor: pointer;
        white-space: nowrap;
      }

      .source-pills button[aria-pressed="false"] {
        opacity: 0.42;
        border-color: var(--line-soft);
      }

